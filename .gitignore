# Secrets and local settings (.env.example is the committed template)
.env
.env.*
!.env.example

# Local archives (SQLite, created by demo/live mode)
data/
*.db
*.db-*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Terraform (infra/): providers, state and saved plans stay local.
# .terraform.lock.hcl is committed so everyone gets the same provider versions.
.terraform/
*.tfstate
*.tfstate.*
terraform.tfstate.d/
*.tfplan
crash.log

# Deploy packages (webapp.zip)
*.zip
